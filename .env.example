# AI Provider (https://console.groq.com/keys)
GROQ_API_KEY=""
GROQ_MODEL="qwen/qwen3.8-27b"
GROQ_MAX_TOKENS=900

# GitHub Access
GITHUB_TOKEN=""
REPO_OWNER="your-username"
REPO_NAME="self-updating-website"
BASE_BRANCH="main"

# Agent behavior
TARGET_FILE="selfUpdatingWeb.html"
INTERVAL_MINUTES=1
CHECK_INTERVAL_SECONDS=10
CHECK_TIMEOUT_MINUTES=10
AUTO_MERGE=false

# Optional deployment metadata
VERCEL_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_ORG_ID=""
